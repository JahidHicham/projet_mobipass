  <MdxScripts>
    <MdxScript dwd:design-time-name="b8e5a813-f08c-4f93-ae21-e13859a134d3">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/* Membres calculés de base du cube Locations */
CALCULATE;

/* Remise accordée : montant public moins montant réellement payé */
CREATE MEMBER CURRENTCUBE.[Measures].[Montant remise]
 AS [Measures].[Montant public] - [Measures].[Montant payé],
FORMAT_STRING = "#,##0.00", VISIBLE = 1;

/* Taux de remise effectif (séquence S2) */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux de remise effectif]
 AS IIF([Measures].[Montant public] = 0, NULL, 1 - [Measures].[Montant payé] / [Measures].[Montant public]),
FORMAT_STRING = "Percent", VISIBLE = 1;

/* Durée moyenne d'une location, en jours */
CREATE MEMBER CURRENTCUBE.[Measures].[Durée moyenne]
 AS IIF([Measures].[Nombre de locations] = 0, NULL, [Measures].[Durée] / [Measures].[Nombre de locations]),
FORMAT_STRING = "#,##0.0", VISIBLE = 1;

/* Montant payé moyen par location */
CREATE MEMBER CURRENTCUBE.[Measures].[Montant payé moyen]
 AS IIF([Measures].[Nombre de locations] = 0, NULL, [Measures].[Montant payé] / [Measures].[Nombre de locations]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1;

/* ---- Taux d'occupation du parc (séquence S1, saturation vue côté offre, avec les seules locations) ---- */

/* Jours couverts par les données : du premier au dernier jour loué */
CREATE SET CURRENTCUBE.[Jours observés]
 AS {HEAD(NONEMPTY([Temps].[Jour].[Jour].MEMBERS, [Measures].[Durée]), 1).ITEM(0)
     : TAIL(NONEMPTY([Temps].[Jour].[Jour].MEMBERS, [Measures].[Durée]), 1).ITEM(0)};

/* Exemplaires loués au moins un jour dans la période et la sélection affichées */
CREATE MEMBER CURRENTCUBE.[Measures].[Exemplaires loués]
 AS COUNT(NONEMPTY(EXISTING [Exemplaire].[Exemplaire].[Exemplaire].MEMBERS, [Measures].[Durée])),
FORMAT_STRING = "#,##0", VISIBLE = 1;

/* Nombre de jours de la période affichée (limité aux jours couverts par les données) */
CREATE MEMBER CURRENTCUBE.[Measures].[Jours de la période]
 AS COUNT(EXISTING [Jours observés]),
FORMAT_STRING = "#,##0", VISIBLE = 0;

/* Taux d'occupation : jours loués / (exemplaires loués x jours de la période). À lire au mois ou à la saison */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux d'occupation]
 AS IIF([Measures].[Exemplaires loués] = 0 OR [Measures].[Jours de la période] = 0, NULL,
        [Measures].[Durée] / ([Measures].[Exemplaires loués] * [Measures].[Jours de la période])),
FORMAT_STRING = "Percent", VISIBLE = 1;

/* ---- Indisponibilité des produits (séquence S1, avec les seules locations) ----
   Un produit n'est pas disponible un jour donné dans une agence quand tous ses exemplaires y sont loués :
   un employé qui venait ce jour-là ne trouvait pas ce produit. Grâce au grain du jour, la Durée d'un jour, d'une
   agence et d'un produit est le nombre d'exemplaires de ce produit loués ce jour-là dans cette agence. */

/* Parc actif : exemplaires du produit et de l'agence loués au moins un jour dans le mois du jour considéré.
   Le mois est redonné explicitement : remettre le jour à All remettrait aussi le mois à All. */
CREATE MEMBER CURRENTCUBE.[Measures].[Parc actif du mois]
 AS ([Measures].[Exemplaires loués], [Temps].[Jour].[All], [Temps].[Semaine].[All],
     [Temps].[Jour de la semaine].[All], [Temps].[Année ISO].[All], [Temps].[Mois].CurrentMember),
FORMAT_STRING = "#,##0", VISIBLE = 0;

/* Jours de rupture : nombre de couples (jour, agence, produit) où tous les exemplaires du parc actif sont loués */
CREATE MEMBER CURRENTCUBE.[Measures].[Jours de rupture]
 AS SUM(EXISTING [Temps].[Jour].[Jour].MEMBERS,
        COUNT(FILTER(NONEMPTY(EXISTING ([Exemplaire].[Agence].[Agence].MEMBERS * [Exemplaire].[Produit].[Produit].MEMBERS),
                              [Measures].[Durée]),
                     [Measures].[Durée] &gt;= [Measures].[Parc actif du mois]))),
FORMAT_STRING = "#,##0", VISIBLE = 1;

/* Jours-produits proposés : couples (jour, agence, produit) où le produit a un parc actif dans l'agence */
CREATE MEMBER CURRENTCUBE.[Measures].[Jours-produits proposés]
 AS SUM(EXISTING [Temps].[Jour].[Jour].MEMBERS,
        COUNT(NONEMPTY(EXISTING ([Exemplaire].[Agence].[Agence].MEMBERS * [Exemplaire].[Produit].[Produit].MEMBERS),
                       ([Measures].[Durée], [Temps].[Jour].[All], [Temps].[Semaine].[All], [Temps].[Jour de la semaine].[All],
                        [Temps].[Année ISO].[All], [Temps].[Mois].CurrentMember)))),
FORMAT_STRING = "#,##0", VISIBLE = 0;

/* Taux de rupture : part des jours-produits où le produit n'était pas disponible (compare des agences de tailles différentes) */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux de rupture]
 AS IIF([Measures].[Jours-produits proposés] = 0, NULL, [Measures].[Jours de rupture] / [Measures].[Jours-produits proposés]),
FORMAT_STRING = "Percent", VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>