xGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e143" value="" style="endArrow=none;html=1;strokeColor=#666666;rounded=0;" edge="1" parent="1" source="e21" target="e140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e144" value="1,n" style="edgeLabel;html=1;fontSize=10;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e143"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e145" value="&lt;i&gt;Appartenir&lt;/i&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1900" y="1040" width="90" height="30" as="geometry"/></mxCell><mxCell id="e146" value="" style="endArrow=none;html=1;strokeColor=#666666;rounded=0;" edge="1" parent="1" source="e21" target="e145"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e147" value="1,1" style="edgeLabel;html=1;fontSize=10;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e146"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e148" value="" style="endArrow=none;html=1;strokeColor=#666666;rounded=0;" edge="1" parent="1" source="e22" target="e145"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e149" value="1,n" style="edgeLabel;html=1;fontSize=10;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e148"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e150" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1F4E79'&gt;■&lt;/span&gt; entité reprise de l'ED V1&lt;br&gt;&lt;span style='color:#C55A11'&gt;■&lt;/span&gt; entité V1 enrichie&lt;br&gt;&lt;span style='color:#2E7D32'&gt;■&lt;/span&gt; nouvelle entité (V2)&lt;br&gt;ovale : association (attributs sous le trait)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#BFBFBF;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="280" height="90" as="geometry"/></mxCell><mxCell id="e151" value="&lt;b&gt;Choix de modélisation&lt;/b&gt;&lt;br&gt;1. Les prix sortent de PRODUIT : ils sont historisés par pays et par période dans l'association Tarifer (RG4, RG5).&lt;br&gt;2. ZONE_GEO réflexive : une seule entité pour une géographie hétérogène (FR : commune, département, région ; DE : Gemeinde, Kreis, district facultatif, Land), avec NiveauZG (RG13).&lt;br&gt;3. Exercer historise les métiers ROME et le type de contrat de chaque salarié (RG9) ; absent pour les salariés allemands (RG11).&lt;br&gt;4. MatriculeSAL et SIRET dans EMPLOYE assurent la correspondance avec le portail RH (RG6) ; vides pour les salariés allemands.&lt;br&gt;5. Classer est en 0,1 : seules les sociétés françaises ont une catégorie juridique INSEE." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="340" y="1080" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. MD1 conceptuel" id="md1c"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="md1c_1" value="&lt;b&gt;MD1 Locations : schéma multidimensionnel conceptuel (formalisme F. Ravat)&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1860" height="30" as="geometry"/></mxCell><mxCell id="md1c_2" value="&lt;div style=&quot;background:#DAE8FC;font-weight:bold;padding:4px;border-bottom:1px solid #1F4E79&quot;&gt;LOCATIONS&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;text-align:left&q