as="geometry"/></mxCell><mxCell id="md2c_127" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_105" target="md2c_107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_128" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_107" target="md2c_117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_129" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_89" target="md2c_109"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_130" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_109" target="md2c_111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_131" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_111" target="md2c_115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_132" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_115" target="md2c_117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_133" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_111" target="md2c_113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_134" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="md2c_113" target="md2c_115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_135" value="&lt;b&gt;H_Type&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1280" y="605" width="60" height="18" as="geometry"/></mxCell><mxCell id="md2c_136" value="&lt;b&gt;H_CJ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="375" width="44" height="18" as="geometry"/></mxCell><mxCell id="md2c_137" value="&lt;b&gt;H_Dom&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="285" width="52" height="18" as="geometry"/></mxCell><mxCell id="md2c_138" value="&lt;b&gt;H_FR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="470" width="44" height="18" as="geometry"/></mxCell><mxCell id="md2c_139" value="&lt;b&gt;H_DE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="530" width="44" height="18" as="geometry"/></mxCell><mxCell id="md2c_140" value="&lt;b&gt;0..1&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A50021;" vertex="1" parent="1"><mxGeometry x="1290" y="385" width="40" height="16" as="geometry"/></mxCell><mxCell id="md2c_141" value="&lt;b&gt;0..1&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A50021;" vertex="1" parent="1"><mxGeometry x="1495" y="595" width="40" height="16" as="geometry"/></mxCell><mxCell id="md2c_142" value="&lt;b&gt;0..1&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A50021;" vertex="1" parent="1"><mxGeometry x="1650" y="470" width="40" height="16" as="geometry"/></mxCell><mxCell id="md2c_143" value="&lt;b&gt;0..1&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A50021;" vertex="1" parent="1"><mxGeometry x="1650" y="545" width="40" height="16" as="geometry"/></mxCell><mxCell id="md2c_144" value="NomSOC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1150" y="500" width="58" height="18" as="geometry"/></mxCell><mxCell id="md2c_145" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_89" target="md2c_144"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_146" value="LibelleCJ3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1375" y="318" width="90" height="18" as="geometry"/></mxCell><mxCell id="md2c_147" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_93" target="md2c_146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_148" value="NomDO" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1375" y="228" width="50" height="18" as="geometry"/></mxCell><mxCell id="md2c_149" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_99" target="md2c_148"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_150" value="&lt;b&gt;Justifications&lt;/b&gt;&lt;br&gt;• Fait ACHATS au grain le plus fin (un achat d'un produit par un employé un jour donné) : analyses par jour, mois et année.&lt;br&gt;• METIER est une dimension à part : le métier est historisé dans l'ED, le fait référence le métier exercé à la date de l'achat. Membre « Non renseigné » pour les salariés allemands.&lt;br&gt;• SOCIETE : catégorie juridique (H_CJ) facultative car INSEE (FR uniquement) ; géographie en hiérarchies multiples incomplètes H_FR / H_DE.&lt;br&gt;• Le paramètre Pays sert au filtrage par pays (un responsable des ventes par pays)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6. MD1 R-OLAP et treillis" id="md1r"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="md1r_1" value="&lt;b&gt;MD1 Locations : modélisation logique R-OLAP dénormalisée (étoile) et données agrégées&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1860" height="30" as="geometry"/></mxCell><mxCell id="md1r_2" value="&lt;div style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:3px&quot;&gt;FAIT_LOCATION&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeEX#&lt;/u&gt;&lt;br&gt;&lt;u&gt;CodeE#&lt;/u&gt;&lt;br&gt;&lt;u&gt;DateJ#&lt;/u&gt;&lt;br&gt;Duree_Loc&lt;br&gt;Montant_Public&lt;br&gt;Montant_Paye&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#1F4E79;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="180" height="116" as="geometry"/></mxCell><mxCell id="md1r_3" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_TEMPS&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;DateJ&lt;/u&gt;&lt;br&gt;JourSemaine&lt;br&gt;Semaine&lt;br&gt;AnneeSemaine&lt;br&gt;Mois&lt;br&gt;LibMois&lt;br&gt;Trimestre&lt;br&gt;Annee&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="180" height="146" as="geometry"/></mxCell><mxCell id="md1r_4" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_EXEMPLAIRE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeEX&lt;/u&gt;&lt;br&gt;NumSerieEX&lt;br&gt;DateMiseServiceEX&lt;br&gt;DateReformeEX&lt;br&gt;CodeP&lt;br&gt;NomP&lt;br&gt;MarqueP&lt;br&gt;PoidsKg&lt;br&gt;AutonomieKm&lt;br&gt;CodeG&lt;br&gt;NomG&lt;br&gt;SecteurG&lt;br&gt;CodeGEN&lt;br&gt;NomGEN&lt;br&gt;CodeFAB&lt;br&gt;NomFAB&lt;br&gt;PaysFAB&lt;br&gt;CodeAG&lt;br&gt;NomAG&lt;br&gt;VilleAG&lt;br&gt;PaysAG&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="190" height="341" as="geometry"/></mxCell><mxCell id="md1r_5" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_EMPLOYE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeE&lt;/u&gt;&lt;br&gt;NomE&lt;br&gt;PrenomE&lt;br&gt;CodeCAT&lt;br&gt;NomCAT&lt;br&gt;SuperCAT&lt;br&gt;CodeSE&lt;br&gt;NomSE&lt;br&gt;CodeSOC&lt;br&gt;NomSOC&lt;br&gt;Ville&lt;br&gt;Departement&lt;br&gt;Region&lt;br&gt;Gemeinde&lt;br&gt;Kreis&lt;br&gt;District&lt;br&gt;Land&lt;br&gt;Pays&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="180" height="296" as="geometry"/></mxCell><mxCell id="md1r_6" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_7" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_8" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_9" value="&lt;b&gt;Treillis partiel des agrégats&lt;/b&gt; (Exemplaire, Employé, Temps)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="600" height="24" as="geometry"/></mxCell><mxCell id="md1r_10" value="&lt;b&gt;(CodeEX, CodeE, DateJ)&lt;/b&gt;&lt;br&gt;données détaillées : FAIT_LOCATION" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1180" y="820" width="320" height="50" as="geometry"/></mxCell><mxCell id="md1r_11" value="&lt;b&gt;(All, CodeE, Semaine)&lt;/b&gt;&lt;br&gt;MV_LOC_EMP_SEM : Sum(Montant_Paye), Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_12" value="&lt;b&gt;(All, CodeSOC, Mois)&lt;/b&gt;&lt;br&gt;MV_LOC_SOC_MOIS : Sum(Montant_Paye), Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1380" y="620" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_13" value="&lt;b&gt;(All, Pays + Region/Land, Mois)&lt;/b&gt;&lt;br&gt;MV_LOC_REG_MOIS : Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.3 (+ graphique)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1380" y="420" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_14" value="&lt;b&gt;(All, All, All)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="140" height="36" as="geometry"/></mxCell><mxCell id="md1r_15" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_10" target="md1r_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_16" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_10" target="md1r_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_17" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_12" target="md1r_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_18" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_13" target="md1r_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_19" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_11" target="md1r_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_20" value="&lt;b&gt;Choix et justifications&lt;/b&gt;&lt;br&gt;• R-OLAP dénormalisé (étoile, règles R1 et R2) : une seule jointure par dimension, ce qui donne les temps de réponse les plus courts pour les analyses quotidiennes du responsable des locations. La redondance est acceptable dans un magasin en lecture seule.&lt;br&gt;• Clé du fait = concaténation des clés étrangères (un exemplaire ne peut être loué deux fois le même jour par le même employé).&lt;br&gt;• Agrégats matérialisés en vues matérialisées Oracle (REFRESH après chaque alimentation, ENABLE QUERY REWRITE) : seuls les nœuds correspondant aux besoins quotidiens B1.1, B1.2, B1.3 sont matérialisés (treillis partiel). MV_LOC_REG_MOIS se calcule à partir de MV_LOC_SOC_MOIS.&lt;br&gt;• Region/Land : Region pour une société française, Land pour une société allemande (NVL(Region, Land))." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1100" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7. MD2 logique" id="md2l"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="md2l_1" value="&lt;b&gt;MD2 Ventes : modèle logique en étoile (Power BI, mode importation)&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1860" height="30" as="geometry"/></mxCell><mxCell id="md2l_2" value="&lt;div style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:3px&quot;&gt;FAIT_ACHAT&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeP#&lt;/u&gt;&lt;br&gt;&lt;u&gt;CodeE#&lt;/u&gt;&lt;br&gt;&lt;u&gt;DateJ#&lt;/u&gt;&lt;br&gt;CodeAPP#&lt;br&gt;CodeSOC#&lt;br&gt;Qte&lt;br&gt;Montant_Public&lt;br&gt;Montant_Paye&lt;br&gt;Benefice&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#1F4E79;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="180" height="161" as="geometry"/></mxCell><mxCell id="md2l_3" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_TEMPS&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;DateJ&lt;/u&gt;&lt;br&gt;Mois&lt;br&gt;LibMois&lt;br&gt;Trimestre&lt;br&gt;Annee&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="180" height="101" as="geometry"/></mxCell><mxCell id="md2l_4" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_PRODUIT&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeP&lt;/u&gt;&lt;br&gt;NomP&lt;br&gt;MarqueP&lt;br&gt;CodeG&lt;br&gt;NomG&lt;br&gt;SecteurG&lt;br&gt;CodeGEN&lt;br&gt;NomGEN&lt;br&gt;CodeFAB&lt;br&gt;NomFAB&lt;br&gt;PaysFAB&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="180" height="191" as="geometry"/></mxCell><mxCell id="md2l_5" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_EMPLOYE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeE&lt;/u&gt;&lt;br&gt;NomE&lt;br&gt;PrenomE&lt;br&gt;CodeCAT&lt;br&gt;NomCAT&lt;br&gt;SuperCAT&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="180" height="116" as="geometry"/></mxCell><mxCell id="md2l_6" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_METIER&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeAPP&lt;/u&gt;&lt;br&gt;LibelleAPP&lt;br&gt;CodeROME&lt;br&gt;LibelleMetier&lt;br&gt;CodeDP&lt;br&gt;LibelleDP&lt;br&gt;CodeGD&lt;br&gt;LibelleGD&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="180" height="146" as="geometry"/></mxCell><mxCell id="md2l_7" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_SOCIETE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeSOC&lt;/u&gt;&lt;br&gt;NomSOC&lt;br&gt;TypeSOC&lt;br&gt;CodeCJ3&lt;br&gt;LibelleCJ3&lt;br&gt;CodeCJ2&lt;br&gt;LibelleCJ2&lt;br&gt;CodeCJ1&lt;br&gt;LibelleCJ1&lt;br&gt;CodeDO&lt;br&gt;NomDO&lt;br&gt;CodeDO_Sup&lt;br&gt;Ville&lt;br&gt;Departement&lt;br&gt;Region&lt;br&gt;Gemeinde&lt;br&gt;Kreis&lt;br&gt;District&lt;br&gt;Land&lt;br&gt;Pays&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1180" y="200" width="190" height="326" as="geometry"/></mxCell><mxCell id="md2l_8" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md2l_2" target="md2l_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2l_9" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md2l_2" target="md2l_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2l_10" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md2l_2" target="md2l_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2l_11" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md2l_2" target="md2l_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2l_12" style="endArrow=ERmany;startArrow=none;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md2l_2" target="md2l_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2l_13" value="&lt;b&gt;Choix et justifications&lt;/b&gt;&lt;br&gt;• Modèle en étoile (R-OLAP dénormalisé), recommandé par Power BI : relations 1-n simples entre dimensions et fait.&lt;br&gt;• Mode importation : Power BI stocke les données dans son propre format (comme pour le SAD actuel), ce qui donne des rapports très réactifs ; actualisation planifiée après chaque alimentation de l'ED.&lt;br&gt;• Sécurité au niveau des lignes (RLS) : rôle « France » avec filtre DIM_SOCIETE[Pays] = &quot;France&quot;, rôle « Allemagne » avec [Pays] = &quot;Allemagne&quot;.&lt;br&gt;• Agrégats : calculés à la volée par le moteur de Power BI (mesures DAX), le volume des achats ne nécessite pas de vues matérialisées." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1420" y="560" width="460" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>