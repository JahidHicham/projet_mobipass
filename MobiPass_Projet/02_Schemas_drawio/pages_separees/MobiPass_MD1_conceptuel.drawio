" as="geometry"/></mxCell><mxCell id="md1c_136" value="PrenomE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1160" y="502" width="66" height="18" as="geometry"/></mxCell><mxCell id="md1c_137" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md1c_88" target="md1c_136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1c_138" value="NomCAT" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1290" y="350" width="58" height="18" as="geometry"/></mxCell><mxCell id="md1c_139" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md1c_90" target="md1c_138"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1c_140" value="NomSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1385" y="485" width="50" height="18" as="geometry"/></mxCell><mxCell id="md1c_141" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md1c_94" target="md1c_140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1c_142" value="NomSOC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1480" y="485" width="58" height="18" as="geometry"/></mxCell><mxCell id="md1c_143" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md1c_96" target="md1c_142"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1c_144" value="&lt;b&gt;Justifications&lt;/b&gt;&lt;br&gt;• Fait LOCATIONS au grain le plus fin (une location) : les analyses B1 et B2 se font à la semaine, au mois et à l'année, toutes déductibles du jour.&lt;br&gt;• TEMPS est multi-hiérarchique : une semaine peut chevaucher deux mois, d'où deux hiérarchies distinctes H_Cal et H_Sem.&lt;br&gt;• EMPLOYE porte la géographie de la société (« quel que soit son pays ») avec deux hiérarchies multiples incomplètes : H_FR et H_DE (district absent dans 9 Länder et pour les villes-États).&lt;br&gt;• EXEMPLAIRE regroupe toutes les informations rattachables aux produits (gamme, marque, génération, fabricant, agence)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>