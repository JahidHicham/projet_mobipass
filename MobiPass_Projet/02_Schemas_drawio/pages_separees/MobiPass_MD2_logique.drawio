<mxfile host="app.diagrams.net"><diagram name="MD2 logique (Power BI)" id="md2l"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="md2l_1" value="&lt;b&gt;MD2 Ventes : modèle logique en étoile (Power BI, mode importation)&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1860" height="30" as="geometry"/></mxCell><mxCell id="md2l_2" value="&lt;div style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:3px&quot;&gt;FAIT_ACHAT&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeP#&lt;/u&gt;&lt;br&gt;&lt;u&gt;CodeE#&lt;/u&gt;&lt;br&gt;&lt;u&gt;DateJ#&lt;/u&gt;&lt;br&gt;CodeAPP#&lt;br&gt;CodeSOC#&lt;br&gt;Qte&lt;br&gt;Montant_Public&lt;br&gt;Montant_Paye&lt;br&gt;Benefice&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#1F4E79;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="180" height="161" as="geometry"/></mxCell><mxCell id="md2l_3" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_TEMPS&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;DateJ&lt;/u&gt;&lt;br&gt;Mois&lt;br&gt;LibMois&lt;br&gt;Trimestre&lt;br&gt;Annee&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="180" height="101" as="geometry"/></mxCell><mxCell id="md2l_4" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_PRODUIT&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeP&lt;