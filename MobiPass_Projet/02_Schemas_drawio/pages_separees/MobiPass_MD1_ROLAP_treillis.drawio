<mxfile host="app.diagrams.net"><diagram name="MD1 R-OLAP et treillis" id="md1r"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="md1r_1" value="&lt;b&gt;MD1 Locations : modélisation logique R-OLAP dénormalisée (étoile) et données agrégées&lt;/b&gt;" style="text;html=1;align=center;fontSize=18;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1860" height="30" as="geometry"/></mxCell><mxCell id="md1r_2" value="&lt;div style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:3px&quot;&gt;FAIT_LOCATION&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeEX#&lt;/u&gt;&lt;br&gt;&lt;u&gt;CodeE#&lt;/u&gt;&lt;br&gt;&lt;u&gt;DateJ#&lt;/u&gt;&lt;br&gt;Duree_Loc&lt;br&gt;Montant_Public&lt;br&gt;Montant_Paye&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#1F4E79;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="180" height="116" as="geometry"/></mxCell><mxCell id="md1r_3" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_TEMPS&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;DateJ&lt;/u&gt;&lt;br&gt;JourSemaine&lt;br&gt;Semaine&lt;br&gt;AnneeSemaine&lt;br&gt;Mois&lt;br&gt;LibMois&lt;br&gt;Trimestre&lt;br&gt;Annee&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="180" height="146" as="geometry"/></mxCell><mxCell id="md1r_4" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_EXEMPLAIRE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeEX&lt;/u&gt;&lt;br&gt;NumSerieEX&lt;br&gt;DateMiseServiceEX&lt;br&gt;DateReformeEX&lt;br&gt;CodeP&lt;br&gt;NomP&lt;br&gt;MarqueP&lt;br&gt;PoidsKg&lt;br&gt;AutonomieKm&lt;br&gt;CodeG&lt;br&gt;NomG&lt;br&gt;SecteurG&lt;br&gt;CodeGEN&lt;br&gt;NomGEN&lt;br&gt;CodeFAB&lt;br&gt;NomFAB&lt;br&gt;PaysFAB&lt;br&gt;CodeAG&lt;br&gt;NomAG&lt;br&gt;VilleAG&lt;br&gt;PaysAG&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="190" height="341" as="geometry"/></mxCell><mxCell id="md1r_5" value="&lt;div style=&quot;background:#555555;color:#fff;font-weight:bold;padding:3px&quot;&gt;DIM_EMPLOYE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:3px 6px&quot;&gt;&lt;u&gt;CodeE&lt;/u&gt;&lt;br&gt;NomE&lt;br&gt;PrenomE&lt;br&gt;CodeCAT&lt;br&gt;NomCAT&lt;br&gt;SuperCAT&lt;br&gt;CodeSE&lt;br&gt;NomSE&lt;br&gt;CodeSOC&lt;br&gt;NomSOC&lt;br&gt;Ville&lt;br&gt;Departement&lt;br&gt;Region&lt;br&gt;Gemeinde&lt;br&gt;Kreis&lt;br&gt;District&lt;br&gt;Land&lt;br&gt;Pays&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;spacing=0;fontSize=10;strokeColor=#555555;strokeWidth=1.5;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="180" height="296" as="geometry"/></mxCell><mxCell id="md1r_6" style="startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_7" value="1..N" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_6"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_8" value="1" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_6"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_9" style="startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_10" value="1..N" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_9"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_11" value="1" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_9"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_12" style="startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;html=1;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="md1r_2" target="md1r_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_13" value="1..N" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_12"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_14" value="1" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#A50021;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="md1r_12"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="md1r_15" value="&lt;b&gt;Treillis partiel des agrégats&lt;/b&gt; (Exemplaire, Employé, Temps)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="600" height="24" as="geometry"/></mxCell><mxCell id="md1r_16" value="&lt;b&gt;(CodeEX, CodeE, DateJ)&lt;/b&gt;&lt;br&gt;données détaillées : FAIT_LOCATION" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1180" y="820" width="320" height="50" as="geometry"/></mxCell><mxCell id="md1r_17" value="&lt;b&gt;(All, CodeE, Semaine)&lt;/b&gt;&lt;br&gt;MV_LOC_EMP_SEM : Sum(Montant_Paye), Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_18" value="&lt;b&gt;(All, CodeSOC, Mois)&lt;/b&gt;&lt;br&gt;MV_LOC_SOC_MOIS : Sum(Montant_Paye), Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1380" y="620" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_19" value="&lt;b&gt;(All, Pays + Region/Land, Mois)&lt;/b&gt;&lt;br&gt;MV_LOC_REG_MOIS : Sum(Duree_Loc)&lt;br&gt;&lt;i&gt;besoin B1.3 (+ graphique)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1380" y="420" width="300" height="60" as="geometry"/></mxCell><mxCell id="md1r_20" value="&lt;b&gt;(All, All, All)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="140" height="36" as="geometry"/></mxCell><mxCell id="md1r_21" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_16" target="md1r_17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_22" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_16" target="md1r_18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_23" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_18" target="md1r_19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_24" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_19" target="md1r_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_25" style="endArrow=block;html=1;strokeColor=#1F4E79;" edge="1" parent="1" source="md1r_17" target="md1r_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md1r_26" value="&lt;b&gt;Choix et justifications&lt;/b&gt;&lt;br&gt;• R-OLAP dénormalisé (étoile, règles R1 et R2) : une seule jointure par dimension, ce qui donne les temps de réponse les plus courts pour les analyses quotidiennes du responsable des locations. La redondance est acceptable dans un magasin en lecture seule.&lt;br&gt;• Clé du fait = concaténation des clés étrangères (un exemplaire ne peut être loué deux fois le même jour par le même employé).&lt;br&gt;• Agrégats matérialisés en vues matérialisées Oracle (REFRESH après chaque alimentation, ENABLE QUERY REWRITE) : seuls les nœuds correspondant aux besoins quotidiens B1.1, B1.2, B1.3 sont matérialisés (treillis partiel). MV_LOC_REG_MOIS se calcule à partir de MV_LOC_SOC_MOIS.&lt;br&gt;• Region/Land : Region pour une société française, Land pour une société allemande (NVL(Region, Land))." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1100" height="140" as="geometry"/></mxCell><mxCell id="md1r_27" value="Cardinalités : une ligne de dimension est référencée par 1..N lignes du fait ; une ligne du fait référence exactement 1 ligne de chaque dimension." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="1100" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>