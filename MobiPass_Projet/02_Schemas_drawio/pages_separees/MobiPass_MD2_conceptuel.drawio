 as="geometry"/></mxCell><mxCell id="md2c_197" value="&lt;b&gt;H_Dom&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="285" width="52" height="18" as="geometry"/></mxCell><mxCell id="md2c_198" value="&lt;b&gt;H_FR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="470" width="44" height="18" as="geometry"/></mxCell><mxCell id="md2c_199" value="&lt;b&gt;H_DE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="530" width="44" height="18" as="geometry"/></mxCell><mxCell id="md2c_200" value="NomSOC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1150" y="500" width="58" height="18" as="geometry"/></mxCell><mxCell id="md2c_201" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_117" target="md2c_200"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_202" value="LibelleCJ3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1375" y="318" width="90" height="18" as="geometry"/></mxCell><mxCell id="md2c_203" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_121" target="md2c_202"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_204" value="NomDO" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="1375" y="228" width="50" height="18" as="geometry"/></mxCell><mxCell id="md2c_205" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1;exitX=0.5;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="md2c_127" target="md2c_204"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="md2c_206" value="Cardinalités des hiérarchies : N côté paramètre enfant, 1 côté parent ; 0..1 quand le parent est facultatif (hiérarchie incomplète)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="900" height="20" as="geometry"/></mxCell><mxCell id="md2c_207" value="&lt;b&gt;Justifications&lt;/b&gt;&lt;br&gt;• Fait ACHATS au grain le plus fin (un achat d'un produit par un employé un jour donné) : analyses par jour, mois et année.&lt;br&gt;• METIER est une dimension à part : le métier est historisé dans l'ED, le fait référence le métier exercé à la date de l'achat. Membre « Non renseigné » pour les salariés allemands.&lt;br&gt;• SOCIETE : catégorie juridique (H_CJ) facultative car INSEE (FR uniquement) ; géographie en hiérarchies multiples incomplètes H_FR / H_DE.&lt;br&gt;• Le paramètre Pays sert au filtrage par pays (un responsable des ventes par pays)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#F7F9FC;strokeColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>